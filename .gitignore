# Python and editor caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.vscode/

# Created by env.sh (CMSSW area) and the grid proxy
/soft
/data

# Outputs.  Skims and histograms live on EOS (config/paths.yaml) and plots
# are published on the web area; nothing produced goes in the repository.
/results/
**/results*/
**/campaigns/
/plots*/
/logs*/
*.log
*.out
*.root
*.tar.gz

# Local notes and generated reports can be ignored explicitly when needed;
# Markdown documentation belongs in this public repository.

# Condor bookkeeping written by the submitters
/htcondor/hists/
/htcondor/systematics/
/htcondor/validation/
/htcondor/skim_v*/
/htcondor/special_sync/
/htcondor/error/
/htcondor/log/
/htcondor/output/
/htcondor/denominator_json/
/studies/*/condor/log/

# Generated by `hmumu skim files`
config/Run3_*/samples_withfiles.yaml

# Combine: workspaces, fits, plots and generated reports stay local.
/combine/results_*/**
.claude/
*.txt
